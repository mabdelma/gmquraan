# Example production env — copy to /var/www/app/.env on the VPS and fill in.
# Never commit the filled copy: .gitignore excludes .env and .env.* (this example
# is whitelisted). The Example stack shares nothing with the app stack, so every
# secret below must be its own value — do not reuse the app ones.

# ── Required: compose refuses to start without these ─────────────────────────
# A long random value, unique to this deployment:  openssl rand -base64 48
AUTH_SECRET=
# Postgres superuser password for app-postgres:    openssl rand -base64 32
POSTGRES_PASSWORD=
# The public origin Caddy serves this stack on. Absolute links in emails,
# invites and OAuth callbacks are built from it, so it must match exactly —
# scheme, host, no trailing slash.
APP_URL=https://example.com
# Where the workforce portal lives. Point it at the same host as APP_URL if you
# are not giving the portal its own subdomain.
PORTAL_URL=https://workforce.example.com

# ── Email (app-notifications) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Example Company <noreply@example.com>

# ── Workforce portal sign-in ─────────────────────────────────────────────────
# Members authenticate against a Dovecot mailbox over TLS. Leave blank until
# Example has its own mail server; password sign-in is then unavailable and
# the portal reports it rather than failing closed.
IMAP_HOST=

# ── Billing ──────────────────────────────────────────────────────────────────
# Separate Stripe webhook endpoint → separate signing secret from the app one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GROWTH_PRICE_ID=

# ── AI advisor ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google sign-in ───────────────────────────────────────────────────────────
# Authorised redirect URI must be <APP_URL>/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Ops ──────────────────────────────────────────────────────────────────────
MONITOR_SECRET=
MONITOR_ALERT_TO=
INBOUND_SECRET=
CRON_SECRET=
MAILCOW_API_URL=
MAILCOW_API_KEY=
# Comma-separated domains this console may manage on the shared mailcow.
MAIL_DOMAINS=example.com,example.com
ORCHESTRATOR_INTERVAL_MS=60000

# ── Push notifications ───────────────────────────────────────────────────────
# Web Push keys are origin-scoped: generate a NEW pair for this domain, the app
# pair will not work here.
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('PUB',c.getPublicKey('base64url'));console.log('PRIV',c.getPrivateKey('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Native store apps only — optional.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
