# ── Shared ───────────────────────────────────────────────────────────────────
# Secret used to sign/verify service JWTs (HS256). Set a long random value in prod.
AUTH_SECRET=dev-insecure-secret
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Local docker-compose Postgres is exposed on :5544
DATABASE_URL=postgresql://app:app@localhost:5544/app

# ── Internal service URLs (cluster DNS in prod) ──────────────────────────────
AUTH_URL_INTERNAL=http://localhost:8081
CATALOG_URL_INTERNAL=http://localhost:8082
BILLING_URL_INTERNAL=http://localhost:8083
ENGAGEMENT_URL_INTERNAL=http://localhost:8084
NOTIFICATIONS_URL_INTERNAL=http://localhost:8085

# ── Email (notifications service) ────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Unskinned <noreply@example.com>

# ── Billing (Phase 5) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI Solutions Advisor (Phase 7) ───────────────────────────────────────────
OPENAI_API_KEY=

# ── Push notifications ───────────────────────────────────────────────────────
# Leave blank to disable (sending is a silent no-op until these are set).
# Web Push (PWA / browser) — SELF-HOSTED, no Firebase. Generate once:
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('PUB',c.getPublicKey('base64url'));console.log('PRIV',c.getPrivateKey('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:founder@example.com
# FCM (native Android app only) — from the Firebase service-account JSON:
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# APNs (iOS) — token-based auth from an Apple .p8 key:
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.example.app
APNS_PRODUCTION=false
